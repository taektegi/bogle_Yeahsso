# 이 파일을 server/.env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.
# 서버에서만 쓰는 값이다. service_role·OpenRouter·OpenAI 키를 앱에 넣지 않는다.

# development | production
APP_ENV=development
LOG_LEVEL=INFO

# Supabase 프로젝트 주소 (예: https://xxxx.supabase.co)
# 비대칭 서명 키(ES256/RS256) 토큰은 이 주소의 JWKS로 검증한다.
SUPABASE_URL=

# 레거시 공유 비밀(HS256) 토큰을 쓰는 프로젝트에서만 채운다.
# Supabase 대시보드 > Project Settings > API 의 JWT Secret
SUPABASE_JWT_SECRET=

# 서버만 쓰는 비밀 키. 앱·저장소·채팅에 절대 올리지 않는다.
# Supabase 대시보드 > Project Settings > API 의 service_role 키
SUPABASE_SERVICE_ROLE_KEY=

# Postgres 직접 연결 문자열 (서버가 친구·프로필을 읽고 쓴다)
# 원격: Supabase 대시보드 > Connect 의 Connection string(pooler)
# 로컬(supabase start): postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# 이미지·대화 생성 및 얼굴 분석용 OpenRouter 키. 앱에는 넣지 않는다.
OPENROUTER_API_KEY=

# 이미지 생성 동시 처리 수(1~2)와 전체 처리 한도(최대 240초).
GENERATION_CONCURRENCY=2
GENERATION_TIMEOUT_SECONDS=240

# 생성된 PNG의 얼굴 좌표를 읽을 이미지 입력 모델 ID (OI-03 확정값).
OPENROUTER_FACE_MODEL=openai/gpt-6-luna
FACE_ANALYSIS_TIMEOUT_SECONDS=120

# 비공개 Storage bucket 이름과 서명 URL 유효 시간(초). 보통 바꾸지 않는다.
STORAGE_BUCKET=bogle-media
SIGNED_URL_TTL_SECONDS=3600

# 미사용 에셋 정리 작업: 실행 간격(초, 0이면 끔)과 보관 시간. 보통 바꾸지 않는다.
CLEANUP_INTERVAL_SECONDS=3600
ASSET_RETENTION_HOURS=24

#OPENROUTER API KEY
openrouter_key=
